<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法根视图:48dp 单行两态(FrameLayout 叠放,按输入状态二选一显示)
  - 组词中:候选行(整行候选)——飞字/选字目标尽量大,状态行(含 L4)整行让位;
    上方浮一条拼音(部分 App 自己不渲染 composing 区),拼音条不占 insets
  - 空闲时:状态行三区——左=状态芯片(拼/En + 大写占位 + 常显的 alt/sym 层芯片),中=L4(固定核心键+
    自定义键,不滚动、填满中区、左右各 6dp 对称边距),右=按钮(宽≥高)
  组词中 touchable 区扩到全屏接飞字。
  高度取 48dp 而非更细的 36dp:芯片/键帽/按钮都要够得着(触摸目标 ≥34dp)。
-->
<dev.hwkbd.ime.ui.ImeRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="bottom"
    android:orientation="vertical">

    <!--
      组词拼音(悬浮):只在 App 自己不渲染 composing 区时显示(Termux 这类),
      能就地显示拼音的 App(EditText 类)直接藏起来;浮在候选条正上方,
      不占 contentTopInsets(应用不 resize)。宽度随文字(至多 300dp),
      不再拉满整屏,像一颗贴底的小气泡。
    -->
    <TextView
        android:id="@+id/preedit_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/preedit_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="300dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/candidate_fg"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
      L5 虚拟按键层:**状态栏上方**的独立键帽行(2026-09-29 用户定案)。
      装 L4 一行自然宽放不下的溢出尾巴(键帽与状态行 L4 同款);**左侧对齐、键宽用自然宽**
      (与 L4 的居中/两端对齐不同:尾行是 L4 的续页,靠左才读成同一条序列);
      齿轮左侧键盘图标点按切显隐——无溢出时 GONE、组词态整行让位。背景与状态行同款(运行时同步主题色);
      内边距对齐状态行**可见内容**左右缘:左 = 安全区 16dp + 芯片 4dp = 20dp(En 芯片左缘)、
      右 = 安全区 16dp + 收起键 marginEnd 6dp = 22dp(收起三角右缘)。
      键帽**贴行底**(tailMode 时 gravity 底对齐):与下方状态行键间距 12dp→6dp(2026-09-29);
      行高 **42dp**(不是 48dp):键仍是 36dp 与状态行同款,贴底后上边正好 6dp——
      原 48dp 行会空出 12dp 上边距,用户嫌太宽(2026-09-29)。上下留白因此都是 6dp。
    -->
    <dev.hwkbd.ime.ui.L4PanelView
        android:id="@+id/l5_panel"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/status_bg"
        android:paddingStart="20dp"
        android:paddingEnd="22dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bar_container"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <!-- 状态行(空闲):左右留安全区,躲开 Titan 2 Elite 底部两角的物理圆角 -->
        <LinearLayout
            android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bar_safe_edge"
            android:paddingEnd="@dimen/bar_safe_edge">

            <!--
              左区:状态芯片。**宽度由权重固定**(0dp + weight),不随内容伸缩——
              与右区按钮盒**等权重 0.4**(2026-09-29 用户定案,此前 0.6):芯片改成
              "只显示已触发的状态"后最坏情况只有 语言+层+大写 三颗 34dp,右区固定三键 48dp,
              两边都不需要那么宽 —— 压到 0.4/0.4/1.2 后 **L4 中区拿到约 60% 宽度**
              (此前 45%),一行能多放一把键、少溢出到 L5。
              **左右必须等宽**:chip_row 与 btn_row 的 weight 相等 ⇒ L4 到屏幕左右两侧距离相等;
              L4 自己再留对称的 6dp 外边距(见 l4_panel 的 marginStart/End)。
              **只显示已触发的状态**:语言芯片恒显,层/大写没触发就 GONE。
              **芯片不可触摸**:切换一律走物理键(Alt / Sym / Shift / Shift+Space),
              这排芯片是纯状态显示。文字芯片 34×34、间距 2dp、此内边距 4dp;
              大写状态是 48dp 的 **Shift 上箭头图标**(与右区三键同款线稿,无背景);
              第一颗可见芯片不留起始间距(否则数字态的 `0-9` 比 `拼`/`En` 多 2dp)。
            -->
            <LinearLayout
                android:id="@+id/chip_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <!-- 芯片:34dp 见方起(minWidth=height,宽不小于高,用户 2026-09-28 定案)——EN 态四颗 = 4×34 + 3×2 + 4 = 146dp ≤ 安全区挤压后的左盒 ~148dp -->
                <TextView
                    android:id="@+id/chip_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="@string/mode_cn"
                    android:textColor="@color/status_active"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!--
                  大写状态:**Shift 上箭头图标**,不是文字按钮(2026-09-29 用户定案
                  "大小写状态标识改为shift上箭头符号 状态改为图标而不是带背景的按钮样式
                  与状态栏右侧风格统一"):48dp 见方、无背景,scaleType=center 按 24dp 原尺寸画,
                  和右区齿轮/键盘/收起三键同一套线稿。一次大写=描边,Caps 锁定=叠加实心底杆。
                  **大写生效才显示**;切换走物理 Shift 键,不可触摸。
                -->
                <ImageView
                    android:id="@+id/chip_shift"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/shift_state"
                    android:scaleType="center"
                    android:src="@drawable/ic_shift"
                    android:visibility="gone" />

                <!--
                  层芯片:**该层生效才显示**,没触发就 GONE(2026-09-29 用户定案,此前两颗常显灰芯片)。
                  锁定=实心,一次性/按住=描边;数字框里 alt 这颗文字换成实际可输字符集(0-9、0-9+*#…)。
                -->
                <TextView
                    android:id="@+id/chip_alt"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="alt"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chip_sym"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="sym"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              中区:L4 键(**等宽槽**单行不滚动;间距固定 4dp,槽宽 = min(填充值, 72dp 封顶):
              键多/行窄 → 恰好铺满=两端对齐;键少/行宽 → 封顶收窄、整组居中;等宽+等距 ⇒
              中线恒过中心键心(奇数把)或中缝(偶数把))。横滑让给手势。
              **到屏幕左右两侧距离相等**:靠 chip_row 与 btn_row 这两个**等权重 0.4** 的盒,
              L4 自己再留对称的 6dp 外边距(和状态行两端 6dp 齐)——权重相等是等距的前提,
              改任一侧的 weight 必须同时改另一侧。中区因此拿到约 60% 宽度。
              内容 = 语言补差键 + 固定核心键 + 键位套,**只显示 L1-L3 敲不出的键**
              (L1-L3 已有的按键一律不进 L4,含数字态合法单字符——默认 L2 全有)。
              L4 必显(设置页开关已删、数字态也不隐藏):数字框显示键位套里的**短语组合**
              (如 `+86`;number/signed/decimal 出厂为空,可在 [L4 xxx] 段放短语)。
            -->
            <dev.hwkbd.ime.ui.L4PanelView
                android:id="@+id/l4_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:visibility="visible" />

            <!--
              右区:按钮(宽 ≥ 高 = 48dp 见方,和条同高,点击目标不小于高)。
              齿轮用 scaleType=center 只按 24dp 原始尺寸画(24dp 线稿的墨迹 ≈16dp),
              不再被 fitCenter 放大到 48dp——否则齿轮墨迹 ≈32dp,和 34dp 的芯片一样大,太抢眼。
              这个盒子同样 **0dp + weight 0.4**,和左区 chip_row **等权重**(两者相等 →
              中区 L4 到屏幕左右两侧距离相等,这是用户 2026-09-29 复核过的硬要求);
              按钮靠 gravity=end 贴屏幕右缘,盒子多出来的部分挪到最左的键盘图标左侧。
            -->
            <LinearLayout
                android:id="@+id/btn_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:baselineAligned="false"
                android:gravity="end"
                android:orientation="horizontal">

            <!--
              L5 行开关:键盘图标,**齿轮左侧**(2026-09-29 用户定案)。
              L4 一行自然宽(36dp 下限 + 4dp 间距)装不下的键尾巴移到**状态栏上方的 L5 行**,
              点按切其显隐;没有溢出时 GONE——按钮全靠 gravity=end 右贴,齿轮/收起位置不跳。
            -->
            <ImageButton
                android:id="@+id/btn_l5"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/btn_l5"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard"
                android:tint="@color/status_fg" />

            <!--
              右区三键**同款 48dp 见方**(2026-09-29 用户定案"状态栏左侧和右侧统一风格"):
              与左区芯片一样是等大方块、一样 48dp 行高、字形都按 scaleType=center 原尺寸画
              (齿轮 24dp 线稿 ≈16dp 墨迹、键盘图标同理、收起三角 16dp)。
              收起键原来 wrap_content + paddingEnd 6dp 的"三角贴右缘"做法一并去掉——
              三角不再比另两个键窄,三个键等宽等高,右区视觉重量与左区一致。
            -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/app_name"
                android:scaleType="center"
                android:src="@drawable/ic_settings"
                android:tint="@color/status_fg" />

            <ImageButton
                android:id="@+id/btn_hide_ime"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/btn_hide"
                android:scaleType="center"
                android:src="@drawable/ic_hide"
                android:tint="@color/status_fg" />
            </LinearLayout>
        </LinearLayout>

        <!-- 候选行(组词中):整行候选;左右同状态行留安全区(底部圆角) -->
        <LinearLayout
            android:id="@+id/candidate_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bar_safe_edge"
            android:paddingEnd="@dimen/bar_safe_edge"
            android:visibility="gone">

            <dev.hwkbd.ime.ui.CandidateBarView
                android:id="@+id/candidate_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
</dev.hwkbd.ime.ui.ImeRootView>
