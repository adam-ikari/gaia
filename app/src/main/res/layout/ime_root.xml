<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法根视图:48dp 单行两态(FrameLayout 叠放,按输入状态二选一显示)
  - 组词中:候选行(整行候选)——飞字/选字目标尽量大,状态行(含 L4)整行让位;
    上方浮一条拼音(部分 App 自己不渲染 composing 区),拼音条不占 insets
  - 空闲时:状态行三区——左=状态项(语言 拼/En + 大写「A」+ 层状态 alt/sym,只显已触发的),
    中=L4(固定核心键+自定义键,不滚动、填满中区、左右各 6dp 对称边距),右=按钮
    (左右两区都定死 [dimen/bar_side_box] 且等宽,中区是唯一带权重的格子)
  组词中 touchable 区扩到全屏接飞字。
  高度取 48dp 而非更细的 36dp:状态项/键帽/按钮都要够得着(触摸目标 ≥34dp)。
-->
<dev.hwkbd.ime.ui.ImeRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="bottom"
    android:orientation="vertical">

    <!--
      组词拼音(悬浮):只在 App 自己不渲染 composing 区时显示(Termux 这类),
      能就地显示拼音的 App(EditText 类)直接藏起来;浮在候选条正上方,
      不占 contentTopInsets(应用不 resize)。宽度随文字(至多 300dp),
      不再拉满整屏,像一颗贴底的小气泡。
    -->
    <TextView
        android:id="@+id/preedit_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/preedit_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="300dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/candidate_fg"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
      L5 虚拟按键层:**状态栏上方**的独立键帽行(2026-09-29 用户定案)。
      装 L4 一行自然宽放不下的溢出尾巴(键帽与状态行 L4 同款),由齿轮左侧键盘图标切显隐;
      无溢出时 GONE、组词态整行让位。**版式与 L4 中区完全一致**(等宽槽:间距 4dp、
      槽宽 = min(填充值, 72dp 封顶),铺满则两端对齐、封顶则整组居中)——**居中**是 2026-09-29
      用户定案(推翻当天的"左对齐 + 自然宽"):左右内边距取**相等**的 [dimen/l5_side_inset],
      行中线因此正好落在屏幕中点上,也就是 L4 中区的中线(左右两区等宽 + L4 自身对称 6dp ⇒
      那个中线 = 屏幕中线)。等宽槽 ⇒ **要么相邻两键的边缘接在中点(偶数把)、要么正中一把键的
      中心对在中点(奇数把)**,和 L4 读成同一个版式。
      背景是**薄底色**(`[ImeService.applyPrefs]` 按主题同步):底下 App 的颜色透上来,
      于是 L5 看着和应用背景一致(2026-09-29 用户定案「L5 从应用取色」)。严格意义的"取色"
      做不到——输入法与 App 跨进程拿不到背后像素,只能"透过来"。透得很彻底而字仍可读,是因为
      **键帽自带不透明底**,文字压在键帽上,透出来的只有键间与行边缘的空隙。
      键帽**上下居中**,行高 **48dp**:键 36dp 上下各 6dp,**到状态行键帽净距 12dp**。
    -->
    <dev.hwkbd.ime.ui.L4PanelView
        android:id="@+id/l5_panel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/l5_tint"
        android:paddingStart="@dimen/l5_side_inset"
        android:paddingEnd="@dimen/l5_side_inset"
        android:visibility="gone" />

    <!--
      L5 行与状态行之间的**分割线**(1dp,主题分隔线色,运行时同步,见 [ImeService.applyPrefs]):
      2026-09-29 用户定案「L5 和状态栏之间加一条分割线」。之前两排同色实心、只靠 12dp 键帽间距
      分开,读起来还是"一整条黑带",看不出 L5 是临时多出来的一排——这条线把"键盘的第二排"
      和"常驻状态行"分开。
      **通栏、不留左右外边距**:原先缩在 [dimen/bar_safe_edge] 以内,两端各露 16dp 底色
      (用户报障「没有延伸到屏幕边缘,导致两侧漏出了底层颜色」)——线是**分隔整条带子**的,
      两头断在半空反而像没画完。底部两角是物理圆角,但分割线离屏幕底边还有 48dp,
      不在圆角影响的范围,通栏不会��裁。
      显隐与 L5 行同步(见 [ImeService.syncL5]):L5 GONE 时这条线也 GONE,不留一道孤线。
    -->
    <View
        android:id="@+id/l5_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/candidate_divider"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bar_container"
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <!-- 状态行(空闲):左右留安全区,躲开 Titan 2 Elite 底部两角的物理圆角 -->
        <LinearLayout
            android:id="@+id/status_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bar_safe_edge"
            android:paddingEnd="@dimen/bar_safe_edge">

            <!--
              左区:状态项。**宽度定死 [bar_side_box]**,不随内容伸缩、也不用权重——
              与右区按钮盒**等宽**(两者相等 ⇒ 中区 L4 到屏幕左右两侧距离相等,这是用户 2026-09-29
              复核过的硬要求,见该 dimen 的注释)。**定死而不是权重**:权重的份额随屏宽漂移,
              窄屏上必然装不下内容而反向外溢压住中区(Titan 2 上就撞过,见 btn_row 注释)。
              装得下:最坏 3 项 = 4(内边距)+34(语言)+2+40(全/半)+2+34(层)= 116dp ≤ 120dp
              ——层状态 alt/sym **互斥**(`effectiveLayer` 单值,只显生效的那个),**大写与层状态也
              互斥**(英文态 `A` 与 alt/sym 只显一项,层优先),数字态又同时藏掉语言和大写,
              所以恒显最多三项,不会变成四项。
              **第四项 `status_fullwidth`(全/半开关,仅拼音态)**:拼音态 `showShift = false`,
              大写恒隐,它顶的是那一项的位置 —— 4+34+2+40+2+34 = 116dp,仍 ≤ 120dp。
              **只显示已触发的状态**:语言恒显,层/大写没触发就 GONE。
              **状态项不可触摸**:切换一律走物理键(Alt / Sym / Shift / Shift+Space),
              这一排是纯状态显示 —— **例外是 `status_fullwidth`**,它本来就是按钮(见该 View 注释)。
              文字项 34×34、间距 2dp、此内边距 4dp;
              第一项可见项不留起始间距(否则数字态的 `0-9` 比 `拼`/`En` 多 2dp)。
            -->
            <LinearLayout
                android:id="@+id/status_left"
                android:layout_width="@dimen/bar_side_box"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <!--
                  语言:34dp 见方起(minWidth = height,宽不小于高,用户 2026-09-28 定案)。
                  恒显(数字类藏掉,数字框没有语言可切),纯字符样式无背景块:主语言=主色字、
                  非主语言=前景色字。
                -->
                <TextView
                    android:id="@+id/status_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="@string/mode_cn"
                    android:textColor="@color/status_active"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!--
                  **中文全角/半角开关**(2026-09-29 用户定案「拼音模式增加一个全角半角的切换
                  按钮放在拼的右侧」)。左区其余状态项一律**不可触摸**(切换走物理键),这颗是
                  例外:硬件键盘上没有"全角/半角"这个物理键,状态行是唯一的入口。

                  文字标签「全」/「半」,标的是**当前状态**(不是"按了会变成什么"),
                  跟右区齿轮/收起同一套按钮语言。宽度 40dp:拼音态 `showShift = false`,
                  大写恒隐,左区最坏是 `拼(34) + 开关(40) + alt(34)` + 内边距/间距 = 116dp,
                  装得进 [bar_side_box] 120dp —— 不必动 bar_side_box(动它等于同时改左右两区,
                  见该 dimen 注释)。**只在拼音态显示**:英文态没有全角概念,数字类直接绕过
                  语言表([ImeController] 的 digitsOnly 分支),两种情况下这颗都是死开关。
                -->
                <TextView
                    android:id="@+id/status_fullwidth"
                    android:layout_width="40dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!--
                  大写状态:**字形本身表达大小写**——`ab` 未大写 / `Ab` 大写一次(含物理 Shift 按住)
                  / `AB` Caps 锁定(2026-09-30 用户定案「把 A 改为 ab Ab AB 的模式,不显示下划线锁定了」;
                  这是一路回到"字形表状态"的老方案,中途被换成过"一把 A + 锁定加下划线")。
                  **因此这一项没有下划线**:大小写由字形说清,alt/sym 的锁定才继续用下划线
                  (两套语言不再混用)。判定在 [dev.hwkbd.ime.ui.StatusRow]。
                  **盒子与层状态同款**(34dp 高 + 12sp 粗体 + 2dp 间距):两个字形与 `alt`/`sym`
                  三个字母同宽量级,同一个盒子读成一排(2026-09-29 用户报「英文大小写锁定的样式和
                  alt/sym 锁定不同」时定的)。
                  **英文态恒显**(`ab` 也在);层生效时藏起(与层状态互斥);切换走物理 Shift 键,不可触摸。
                -->
                <TextView
                    android:id="@+id/status_shift"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/shift_state"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!--
                  层状态:**生效的那个才显示**,没触发就 GONE(2026-09-29 用户定案,此前两项常显灰字),
                  **alt 与 sym 互斥**(`effectiveLayer` 是单值,只显当前那一层)。
                  锁定=加下划线,借用/按住=无下划线(见 [ImeService.paintItem]);
                  数字框里 alt 这一项文字换成实际可输字符集(`0-9`、`0-9+*#`、`0-9-/:` 等),
                  比 34dp 见方宽也装得进 [bar_side_box]——数字态只剩这一项。
                -->
                <TextView
                    android:id="@+id/status_alt"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="alt"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_sym"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="34dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="sym"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              中区:L4 键(**等宽槽**单行不滚动;间距固定 4dp,槽宽 = min(填充值, 72dp 封顶):
              键多/行窄 → 恰好铺满=两端对齐;键少/行宽 → 封顶收窄、整组居中;等宽+等距 ⇒
              中线恒过中心键心(奇数把)或中缝(偶数把))。横滑让给手势。
              **全条状态行唯一带权重的格子**(weight 1):左右两区都定死 [bar_side_box] 且等宽
              ⇒ 中区拿到剩余宽度,**到屏幕左右两侧距离相等**——等宽是等距的前提,
              改任一侧的宽度必须同时改另一侧(改 [dimen/bar_side_box] 一处即可)。
              内容 = 语言补差键 + 固定核心键 + 键位套,**只显示 L1-L3 敲不出的键**
              (L1-L3 已有的按键一律不进 L4,含数字态合法单字符——默认 L2 全有)。
              L4 必显(设置页开关已删、数字态也不隐藏):数字框显示键位套里的**短语组合**
              (如 `+86`;number/signed/decimal 出厂为空,可在 [L4 xxx] 段放短语)。
            -->
            <dev.hwkbd.ime.ui.L4PanelView
                android:id="@+id/l4_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:visibility="visible" />

            <!--
              右区:按钮。**宽度定死 [bar_side_box] = 3 × [btn_size] = 120dp**,和左区 status_left
              **等宽**(等宽 ⇒ 中区 L4 到屏幕左右两侧距离相等,用户 2026-09-29 复核过的硬要求)。
              **盒宽必须 ≥ 三键自然宽**,否则 LinearLayout 在 gravity=end 下把 childLeft 算成负数、
              三个键整体向左反向外溢压住中区键帽——这正是 2026-09-29 用户报障的
              「邮箱输入模式 L4 和右侧按钮重叠」:当时这个盒是 0.4 权重,Titan 2(576dp 宽)上只分到
              123dp,却要装 3×48dp = 144dp,左溢 21dp;btn_l5 只在有溢出时显示,一显示就压住
              L4 末键(实测键帽右缘 1087px、该键触摸框从 1052px 起)。**根因是盒装不下内容**,
              调权重调更小只会外溢更多,正解是把键宽收到 [btn_size] 让内容正好装满盒子。
              按钮靠 gravity=end 贴屏幕右缘:btn_l5 无溢出时 GONE,多出来的 40dp 挪到它左侧,
              **齿轮/收起位置不跳**。
            -->
            <LinearLayout
                android:id="@+id/btn_row"
                android:layout_width="@dimen/bar_side_box"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:gravity="end"
                android:orientation="horizontal">

            <!--
              L5 行开关:键盘图标,**齿轮左侧**(2026-09-29 用户定案)。
              L4 一行自然宽(36dp 下限 + 4dp 间距)装不下的键尾巴移到**状态栏上方的 L5 行**,
              点按切其显隐;没有溢出时 GONE——按钮全靠 gravity=end 右贴,齿轮/收起位置不跳。

              `tools:ignore="UseAppTint"`:本布局由 [ImeService] 用**自己的 LayoutInflater** 展开,
              上下文不是 AppCompat ⇒ `app:tint` 根本不会被解析(会静默丢掉染色,按钮变成黑图标)。
              这里必须用平台的 `android:tint`(API 21+),lint 那条规则在此处是误报。
            -->
            <ImageButton
                android:id="@+id/btn_l5"
                android:layout_width="@dimen/btn_size"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/btn_l5"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard"
                android:tint="@color/status_fg"
                tools:ignore="UseAppTint" />

            <!--
              右区三键**同款宽度 [btn_size] = 40dp**,行高与状态行同高(48dp)。
              宽度从 48dp 收到 40dp 是 2026-09-29 用户定案:3 × 40 = 120dp 正好装满 [bar_side_box],
              3 × 48 = 144dp 装不进、在窄屏上会把 L4 末键压住(见 btn_row 注释)。
              scaleType=center,字形按原始尺寸画(齿轮 24dp 线稿 ≈16dp 墨迹)不被拉伸。
              `tools:ignore` 同 btn_l5:非 AppCompat 上下文,只能用 `android:tint`。
            -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="@dimen/btn_size"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/app_name"
                android:scaleType="center"
                android:src="@drawable/ic_settings"
                android:tint="@color/status_fg"
                tools:ignore="UseAppTint" />

            <ImageButton
                android:id="@+id/btn_hide_ime"
                android:layout_width="@dimen/btn_size"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/btn_hide"
                android:scaleType="center"
                android:src="@drawable/ic_hide"
                android:tint="@color/status_fg"
                tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>

        <!-- 候选行(组词中):整行候选;左右同状态行留安全区(底部圆角) -->
        <LinearLayout
            android:id="@+id/candidate_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/status_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bar_safe_edge"
            android:paddingEnd="@dimen/bar_safe_edge"
            android:visibility="gone">

            <dev.hwkbd.ime.ui.CandidateBarView
                android:id="@+id/candidate_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
</dev.hwkbd.ime.ui.ImeRootView>
