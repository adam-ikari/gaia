<!-- 输入法根视图:单行紧凑输入条(36dp)+ 屏幕键盘(可选,默认隐藏) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/status_bg"
    android:orientation="vertical">

    <!-- 单行紧凑输入条:模式 + 组词 + 候选(手势)+ 翻页 + 开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_mode"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minWidth="30dp"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:text="@string/mode_cn"
        android:textColor="@color/status_active"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_composition"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:textColor="@color/candidate_matched"
        android:textSize="12sp" />

    <!-- 候选区:点选 / 上滑选字 / 左右滑翻页,占满剩余宽度 -->
    <dev.hwkbd.ime.ui.CandidateBarView
        android:id="@+id/candidate_bar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_page"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/candidate_hint"
        android:textSize="10sp" />

    <ImageButton
        android:id="@+id/btn_soft_keyboard"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/pref_show_soft_keyboard"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="@color/status_fg" />

    <ImageButton
        android:id="@+id/btn_hide_ime"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/status_fg" />
    </LinearLayout>

    <!-- 屏幕键盘:三层层切换 + 5 区上滑选字(默认隐藏,偏好开启后显示) -->
    <dev.hwkbd.ime.ui.SoftKeyboardView
        android:id="@+id/soft_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
