<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法根视图：
  状态条（输入方式 + 组词预览 + 翻页） / 候选栏（手势） / 屏幕键盘（可隐藏，手势承载体）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical">

    <!-- 状态条 -->
    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/status_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tv_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="34dp"
            android:gravity="center"
            android:text="@string/mode_cn"
            android:textColor="@color/status_active"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_composition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/status_fg"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/candidate_hint"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_soft_keyboard"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pref_show_soft_keyboard"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/status_fg" />

        <ImageButton
            android:id="@+id/btn_hide_ime"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/status_fg" />
    </LinearLayout>

    <!-- 候选栏：点选 / 上滑选字 / 左右滑翻页 -->
    <dev.hwkbd.ime.ui.CandidateBarView
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp" />

    <!-- 屏幕键盘：三层层切换 + 5 区上滑选字（屏幕版飞字） -->
    <dev.hwkbd.ime.ui.SoftKeyboardView
        android:id="@+id/soft_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
