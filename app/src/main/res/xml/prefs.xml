<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/titan2_fn_hint_title">
        <Preference
            android:key="titan2_fn_hint"
            android:enabled="false"
            android:shouldDisableView="false"
            android:summary="@string/titan2_fn_hint_body" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_general">
        <ListPreference
            android:key="theme"
            android:defaultValue="obsidian"
            android:title="@string/pref_theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:summary="%s" />
        <SwitchPreferenceCompat
            android:key="fullwidth_symbols_in_cn"
            android:defaultValue="true"
            android:title="@string/pref_fullwidth" />
        <!-- 长按字母键上屏 L2 符号(2026-10-15 用户定,默认开;2026-10-16 收窄为只支持字母键) -->
        <SwitchPreferenceCompat
            android:key="longpress_l2"
            android:defaultValue="true"
            android:title="@string/pref_longpress_l2"
            android:summary="@string/pref_longpress_l2_desc" />
        <!-- 语音输入默认关:录音是敏感权限,IME 自己不能弹权限框,只能从设置页开 -->
        <SwitchPreferenceCompat
            android:key="voice_input"
            android:defaultValue="false"
            android:title="@string/pref_voice_input"
            android:summary="@string/pref_voice_input_desc" />
        <!-- 语音识别引擎:默认本地离线;云端需要用户自己的密钥 -->
        <ListPreference
            android:key="voice_engine"
            android:defaultValue="LOCAL"
            android:title="@string/pref_voice_engine"
            android:entries="@array/voice_engine_entries"
            android:entryValues="@array/voice_engine_values"
            android:summary="%s" />
        <SwitchPreferenceCompat
            android:key="swipe_page"
            android:defaultValue="true"
            android:title="@string/pref_swipe_page" />
        <SwitchPreferenceCompat
            android:key="haptic"
            android:defaultValue="true"
            android:title="@string/pref_haptic"
            android:summary="@string/pref_haptic_desc" />
        <ListPreference
            android:key="fly_threshold"
            android:defaultValue="40"
            android:title="@string/pref_fly_threshold"
            android:entries="@array/fly_threshold_entries"
            android:entryValues="@array/fly_threshold_values"
            android:summary="%s" />
        <ListPreference
            android:key="page_threshold"
            android:defaultValue="normal"
            android:title="@string/pref_page_threshold"
            android:entries="@array/page_threshold_entries"
            android:entryValues="@array/page_threshold_values"
            android:summary="%s" />
        <ListPreference
            android:key="key_gate_ms"
            android:defaultValue="300"
            android:title="@string/pref_key_gate"
            android:entries="@array/key_gate_entries"
            android:entryValues="@array/key_gate_values"
            android:summary="%s" />
        <SwitchPreferenceCompat
            android:key="page_reverse"
            android:defaultValue="false"
            android:title="@string/pref_page_reverse" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="voice_cloud_category"
        android:title="@string/pref_voice_cloud_category">
        <Preference
            android:key="voice_cloud_warning"
            android:enabled="false"
            android:shouldDisableView="false"
            android:summary="@string/pref_voice_cloud_warning" />
        <!-- 腾讯云一句话识别 -->
        <EditTextPreference
            android:key="tencent_secret_id"
            android:title="@string/pref_tencent_id" />
        <EditTextPreference
            android:key="tencent_secret_key"
            android:title="@string/pref_tencent_key" />
        <!-- 讯飞流式听写 -->
        <EditTextPreference
            android:key="xfyun_app_id"
            android:title="@string/pref_xfyun_app_id" />
        <EditTextPreference
            android:key="xfyun_api_key"
            android:title="@string/pref_xfyun_api_key" />
        <EditTextPreference
            android:key="xfyun_api_secret"
            android:title="@string/pref_xfyun_api_secret" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_keys">
        <Preference
            android:key="select_keys"
            android:title="@string/pref_select_keys"
            android:summary="@string/select_keys_summary"
            android:enabled="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_dict">
        <Preference
            android:key="dict_reset"
            android:title="@string/pref_dict_reset" />
        <Preference
            android:key="dict_stats"
            android:title="@string/pref_dict_stats" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_dev">
        <Preference
            android:key="playground"
            android:title="@string/playground_title" />
        <Preference
            android:key="probe"
            android:title="@string/pref_probe" />
        <Preference
            android:key="about"
            android:title="@string/pref_about" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_licenses">
        <Preference
            android:key="licenses"
            android:title="@string/pref_licenses" />
    </PreferenceCategory>
</PreferenceScreen>
