<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 长按空格语音输入:识别在 sherpa-onnx 本地跑,这是应用唯一的敏感权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 不声明 INTERNET:语音、词库、候选、设置全部离线,应用没有任何联网功能 -->

    <!-- 探测页导出键值日志：用系统分享面板导出文本，因此声明可见查询 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".ImeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HwKbd">

        <!-- 输入法服务 -->
        <service
            android:name=".service.ImeService"
            android:directBootAware="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@android:style/Theme.InputMethod">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 真机按键探测：抓 Sym / Fn / 方向键真实 keycode -->
        <activity
            android:name=".probe.KeyProbeActivity"
            android:exported="true"
            android:label="@string/probe_title"
            android:windowSoftInputMode="stateVisible" />

        <!-- 实验场:干净输入框试拼音/飞字/层切换(exported 便于 adb 直启测试) -->
        <activity
            android:name=".playground.PlaygroundActivity"
            android:exported="true"
            android:label="@string/playground_title"
            android:windowSoftInputMode="stateVisible" />
    </application>
</manifest>
