# Gradle
.gradle/
build/

# 离线语音模型的构建期缓存(78MB 的 tar.bz2,由 :app:fetchVoiceModel 下载)
#
# 不进 git:它是一次性下载的原料,产物 zip 由构建重新生成;而且这台机器
# 传 8MB 以上就会被 HTTP 408 掐断,把 78MB 提交进历史等于整个仓库推不上去。
# `./gradlew clean` 不清这里 —— 只有第一次构建需要网络。
.cache/

# IDE
.idea/
*.iml

# Local config
local.properties

# Python venv
.venv/

# OS
.DS_Store

# dictgen
node_modules/

# 站点(web/,VitePress)
#
# APK 与 manifest 都是**构建期的中间产物**,不提交:
#   · `_artifact-manifest.json` 由 publish-site.sh 每次构建前重写(指向那一版的
#     release 资产),提交它就是把一个会过期的坐标放进历史;
#   · `public/media/` 是包的老落点。2026-10-26 起包落去临时目录,因为 β/dev 各自
#     103,060,018 / 130,072,818 字节**超过 GitHub 单文件 100.00MB 的服务端硬上限**
#     (push 被 GH001 拒)。这条规则留着是因为有人为了看页面渲染手动丢一个包进去时,
#     `git add -A` 会连它一起带走 —— 那正是上面那个上限要拦的东西。
web/docs/public/media/
web/docs/public/_artifact-manifest.json
web/docs/.vitepress/dist/
web/docs/.vitepress/cache/

# 本机调试临时文件
.qoder/
.tapfeet/
.coco/
.probe_screen.png
.ui.xml
.getevent.log
.coco.apk
.tapfeet.apk

# AI 测试证据
tools/aitest/evidence/

# 素材采集的本地产物(截图/录屏/裁剪结果)。1.5MB 一次性图片,
# 真机重跑一次就变,进 git 只会让每次发版 diff 都带一堆二进制。
out/

# 并行会话调试残留
_tmp_*
_tmp_s1.png
_tmp_s2.png
_tmp_s3.png
_tmp_sm.png
_tmp_t1.png
_tmp_lc.txt

# native (NDK/CMake) 中间产物 —— 可由 CMakeLists 重建,几十 MB,不该进库
app/.cxx/
app/src/main/cpp/librime/build/

# R8 产物:mapping.txt 是**每个版本一份**的符号表,归 release.yml 的 artifact 管,
# 不进版本库(8MB+ 且每个版本都会变)。resources.txt / seeds.txt / usage.txt 同理。
app/build/outputs/mapping/

# 本地调试日志(gradle / submodule / 构建脚本留下的)
*.log
