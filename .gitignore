# Gradle
.gradle/
build/

# IDE
.idea/
*.iml

# Local config
local.properties

# Python venv
.venv/

# OS
.DS_Store

# dictgen
node_modules/

# 站点(web/,VitePress)
#
# **APK 不进本仓库的 git**:它每次发版变一次,6.9–28MB,进历史只是让每次
# diff 都拖着一堆二进制。取包在 publish-site.sh 里做(落到下面这个目录),
# 构建完只把**产物**推进公开仓。
web/docs/public/media/
web/docs/.vitepress/dist/
web/docs/.vitepress/cache/

# 本机调试临时文件
.tapfeet/
.coco/
.probe_screen.png
.ui.xml
.getevent.log
.coco.apk
.tapfeet.apk

# AI 测试证据
tools/aitest/evidence/

# 素材采集的本地产物(截图/录屏/裁剪结果)。1.5MB 一次性图片,
# 真机重跑一次就变,进 git 只会让每次发版 diff 都带一堆二进制。
out/

# 并行会话调试残留
_tmp_*
_tmp_s1.png
_tmp_s2.png
_tmp_s3.png
_tmp_sm.png
_tmp_t1.png
_tmp_lc.txt

# native (NDK/CMake) 中间产物 —— 可由 CMakeLists 重建,几十 MB,不该进库
app/.cxx/
app/src/main/cpp/librime/build/

# R8 产物:mapping.txt 是**每个版本一份**的符号表,归 release.yml 的 artifact 管,
# 不进版本库(8MB+ 且每个版本都会变)。resources.txt / seeds.txt / usage.txt 同理。
app/build/outputs/mapping/

# 本地调试日志(gradle / submodule / 构建脚本留下的)
*.log
